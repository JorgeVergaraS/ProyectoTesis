rabbit.{$OBS_DOMAIN} {
	# RabbitMQ Management validates its own monitoring user over HTTPS.
	reverse_proxy {$APP_PRIVATE_IP}:15672
}

kafka.{$OBS_DOMAIN} {
	basicauth {
		{$OBS_USERNAME} {$OBS_PASSWORD_HASH}
	}
	reverse_proxy kafka-ui:8080
}

grafana.{$OBS_DOMAIN} {
	basicauth {
		{$OBS_USERNAME} {$OBS_PASSWORD_HASH}
	}
	reverse_proxy grafana:3000
}
