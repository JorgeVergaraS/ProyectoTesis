# Local development only. Copy to .env and change the password.
POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Phase 4: optional Docker Compose profile "media". Generate your own random credentials.
NEXO_BROADCASTS_ENABLED=false
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
NEXO_TURN_URL=
NEXO_TURN_SECRET=
# Windows Docker Desktop: set to the workstation IPv4 (Get-NetIPConfiguration).
# Only RTC ports bind this address; the web/API/signaling ports remain loopback.
LIVEKIT_NODE_IP=127.0.0.1

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexo
SPRING_DATASOURCE_USERNAME=nexo
SPRING_DATASOURCE_PASSWORD=change-me
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Opt in only for the local multi-user demo (never deploy publicly).
# SPRING_PROFILES_ACTIVE=local-demo

# Reserved for the authentication phase; not used yet.
AZURE_TENANT_ID=YOUR_TENANT_ID
AZURE_FRONTEND_CLIENT_ID=YOUR_FRONTEND_CLIENT_ID
AZURE_API_CLIENT_ID=YOUR_API_CLIENT_ID
AZURE_API_SCOPE=YOUR_API_SCOPE
NEXO_JWT_SECRET=replace-with-at-least-32-random-characters
AZURE_ISSUER=https://login.microsoftonline.com/21a4bbb2-fc48-4053-a98e-b805aa2306cc/v2.0
AZURE_AUDIENCE=0f2d7cee-cabb-4482-900d-64fb07f5f81d
AZURE_JWK_SET_URI=https://login.microsoftonline.com/21a4bbb2-fc48-4053-a98e-b805aa2306cc/discovery/v2.0/keys
AZURE_REQUIRED_SCOPE=access_as_user
